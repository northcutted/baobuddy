{
  "sourceLanguage" : "en",
  "strings" : {
    "01_Dashboard" : {
      "comment" : "App Store screenshot 1 headline, over the Grants screen in Demo Mode with an active short-lived grant on a build machine. Two short lines. Agents are automated tools (such as AI coding agents) that use the secrets.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسرار قصيرة الأجل\nلوكلائك"
