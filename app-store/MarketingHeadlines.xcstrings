    "03_Settings" : {
      "comment" : "App Store screenshot 3 headline, over Settings with the server's approval key. Two short lines. OpenBao, Vault and Secure Enclave are product names.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
