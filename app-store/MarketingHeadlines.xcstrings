    "04_DirectToken" : {
      "comment" : "App Store screenshot 4 headline, over a short-lived token and database credentials shown in the app (a direct token: for the user, not sent to a remote host). Two short lines.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصدر رمزًا لنفسك\nتنتهي صلاحيته تلقائيًا"
