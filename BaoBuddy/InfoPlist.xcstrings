        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BaoBuddy verwendet die Kamera, um Kopplungs-QR-Codes für OpenBao / Vault-Server von deinem Mac oder aus dem Terminal zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "BaoBuddy uses the camera to scan OpenBao / Vault server pairing QR codes from your Mac or Terminal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BaoBuddy usa la cámara para escanear códigos QR de vinculación de servidores OpenBao / Vault desde tu Mac o Terminal."
