    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description. Shown when the app first asks for local network access. A grant target is the computer that receives access grants.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتصل BaoBuddy بخادم OpenBao وهدف المنح المحلي عبر شبكتك الخاصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BaoBuddy verbindet sich über dein privates Netzwerk mit deinem OpenBao-Server und dem lokalen Freigabeziel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "BaoBuddy connects to your OpenBao server and local grant target over your private network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BaoBuddy se conecta a tu servidor OpenBao y al destino local de autorizaciones a través de tu red privada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
