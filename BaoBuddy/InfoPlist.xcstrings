    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description. Shown when the app first asks to use Face ID. Face ID and Secure Enclave are Apple product names.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
