    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description. Shown when the app first asks for the camera. OpenBao and Vault are product names.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم BaoBuddy الكاميرا لمسح رموز QR لاقتران خوادم OpenBao / Vault من Mac أو Terminal."
