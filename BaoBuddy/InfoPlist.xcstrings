          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "BaoBuddy uses Face ID to sign short-lived OpenBao authentication tokens in the Secure Enclave."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BaoBuddy usa Face ID para firmar tokens de autenticación de OpenBao de corta duración en el Secure Enclave."
