        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "접근 권한과 함께 발급되어 여기에 표시됩니다. 접근 권한이 철회되거나 만료되면 종료됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aangemaakt met de machtiging en hier getoond. Ze vervallen wanneer de machtiging wordt ingetrokken of verloopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tworzone wraz z uprawnieniem i wyświetlane tutaj. Wygasają, gdy uprawnienie zostanie odwołane lub wygaśnie."
