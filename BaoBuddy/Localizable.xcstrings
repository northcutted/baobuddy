        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideal, wenn du deinen eigenen OpenBao- oder HashiCorp Vault-Server verbindest und eigene Richtlinien definierst."
          }
        },
        "es" : {
          "stringUnit" : {
