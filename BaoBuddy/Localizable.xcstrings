          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapas med behörigheten och visas här. De upphör när behörigheten återkallas eller löper ut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzinle birlikte oluşturulur ve burada gösterilir. İzin iptal edildiğinde veya süresi dolduğunda sona ererler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随授权签发并显示在这里。授权被撤销或过期时即失效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
