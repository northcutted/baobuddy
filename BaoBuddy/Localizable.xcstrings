    "Sign short-lived ES256 JWTs in Apple's Secure Enclave with %@ — no passwords stored or typed." : {
      "comment" : "Welcome screen. %@ is Face ID, Touch ID or the word biometrics. ES256, JWT and Secure Enclave are technical/product names.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقّع رموز ES256 JWT قصيرة الأجل في Secure Enclave من Apple باستخدام %@ — دون تخزين كلمات سر أو كتابتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signiere kurzlebige ES256-JWTs in Apples Secure Enclave mit %@ — ohne gespeicherte oder eingegebene Passwörter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firma JWT ES256 de corta duración en el Secure Enclave de Apple con %@ — sin contraseñas guardadas ni escritas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firma JWT ES256 de corta duración en el Secure Enclave de Apple con %@ — sin contraseñas guardadas ni escritas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signez des JWT ES256 éphémères dans la Secure Enclave d’Apple avec %@ — aucun mot de passe stocké ni saisi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firma JWT ES256 di breve durata nel Secure Enclave di Apple con %@ — nessuna password memorizzata o digitata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を使って Apple の Secure Enclave で短期間有効な ES256 JWT に署名します。パスワードの保存や入力は不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@(으)로 Apple Secure Enclave에서 단기 ES256 JWT에 서명합니다. 암호를 저장하거나 입력할 필요가 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderteken kortlevende ES256-JWT's in de Secure Enclave van Apple met %@ — geen wachtwoorden opgeslagen of getypt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpisuj krótkotrwałe tokeny JWT ES256 w Secure Enclave firmy Apple przy użyciu %@ — bez zapisywania i wpisywania haseł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assine JWTs ES256 de curta duração no Secure Enclave da Apple com %@ — sem senhas armazenadas ou digitadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assine JWTs ES256 de curta duração no Secure Enclave da Apple com %@ — sem palavras-passe guardadas nem introduzidas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signera kortlivade ES256-JWT:er i Apples Secure Enclave med %@ — inga lösenord lagras eller skrivs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'ın Secure Enclave'inde %@ ile kısa ömürlü ES256 JWT'ler imzalayın — parola saklanmaz veya yazılmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 %@ 在 Apple Secure Enclave 中签署短期 ES256 JWT，无需存储或输入密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 %@ 在 Apple Secure Enclave 中簽署短期 ES256 JWT，無需儲存或輸入密碼。"
          }
        }
      }
    },
    "Sign short-lived OpenBao SSH user certificates for bastions and servers instead of distributing permanent SSH keys." : {
      "comment" : "Help: use case. A bastion is a jump server.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقّع شهادات مستخدم SSH قصيرة الأجل من OpenBao لخوادم العبور (bastion) والخوادم بدلًا من توزيع مفاتيح SSH دائمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signiere kurzlebige OpenBao-SSH-Benutzerzertifikate für Bastion-Hosts und Server, statt dauerhafte SSH-Schlüssel zu verteilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firma certificados de usuario SSH de OpenBao de corta duración para bastiones y servidores en lugar de distribuir claves SSH permanentes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firma certificados de usuario SSH de OpenBao de corta duración para bastiones y servidores en lugar de distribuir claves SSH permanentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signez des certificats utilisateur SSH OpenBao éphémères pour les bastions et serveurs au lieu de distribuer des clés SSH permanentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firma certificati utente SSH OpenBao di breve durata per bastion host e server invece di distribuire chiavi SSH permanenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永続的な SSH キーを配布する代わりに、踏み台サーバやサーバ用に短期間有効な OpenBao SSH ユーザ証明書に署名します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영구 SSH 키를 배포하는 대신 배스천 및 서버용 단기 OpenBao SSH 사용자 인증서에 서명합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderteken kortlevende OpenBao-SSH-gebruikerscertificaten voor bastions en servers in plaats van permanente SSH-sleutels te verspreiden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpisuj krótkotrwałe certyfikaty użytkownika SSH z OpenBao dla bastionów i serwerów zamiast rozdawać stałe klucze SSH."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assine certificados de usuário SSH de curta duração do OpenBao para bastions e servidores, em vez de distribuir chaves SSH permanentes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assine certificados de utilizador SSH de curta duração do OpenBao para bastiões e servidores, em vez de distribuir chaves SSH permanentes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signera kortlivade OpenBao SSH-användarcertifikat för bastionvärdar och servrar i stället för att distribuera permanenta SSH-nycklar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalıcı SSH anahtarları dağıtmak yerine bastion sunucuları ve diğer sunucular için kısa ömürlü OpenBao SSH kullanıcı sertifikaları imzalayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为堡垒机和服务器签署短期 OpenBao SSH 用户证书，无需分发永久 SSH 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為跳板機和伺服器簽署短期 OpenBao SSH 使用者憑證，無需分發永久 SSH 金鑰。"
          }
        }
      }
    },
    "Simulated in-memory server — nothing leaves this device." : {
      "comment" : "Approval sheet note in demo mode.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خادم محاكى في الذاكرة — لا شيء يغادر هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulierter Server im Arbeitsspeicher — nichts verlässt dieses Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servidor simulado en memoria — nada sale de este dispositivo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servidor simulado en memoria — nada sale de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveur simulé en mémoire — rien ne quitte cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server simulato in memoria — nulla lascia questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリ内のシミュレートされたサーバ — このデバイスから何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모리 내 시뮬레이션 서버 — 이 기기 밖으로 아무것도 전송되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
