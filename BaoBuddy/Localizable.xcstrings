    "Keep agents locked out of secrets and SSH by default; approve time-boxed grants from your phone via baobuddy:// links." : {
      "comment" : "Help: use case. Agents are AI coding agents. Do not translate baobuddy://.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ الوكلاء بعيدين عن الأسرار وSSH افتراضيًا، ووافق على منح محددة المدة من هاتفك عبر روابط baobuddy://."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte Agents standardmäßig von Secrets und SSH fern; genehmige zeitlich begrenzte Freigaben auf deinem iPhone über baobuddy://-Links."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén a los agentes sin acceso a secretos ni a SSH por defecto; aprueba desde tu móvil autorizaciones con límite de tiempo mediante enlaces baobuddy://."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén a los agentes sin acceso a secretos ni a SSH por defecto; aprueba desde tu teléfono autorizaciones con límite de tiempo mediante enlaces baobuddy://."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez les agents à l’écart des secrets et de SSH par défaut ; approuvez depuis votre téléphone des autorisations limitées dans le temps via des liens baobuddy://."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni gli agenti lontani da segreti e SSH per impostazione predefinita; approva autorizzazioni a tempo dal telefono tramite link baobuddy://."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトではエージェントをシークレットや SSH から締め出し、baobuddy:// リンク経由で期間限定のグラントを iPhone から承認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로 에이전트가 시크릿과 SSH에 접근하지 못하게 하고, baobuddy:// 링크를 통해 휴대폰에서 기간 제한 접근 권한을 승인합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd agents standaard weg van geheimen en SSH; keur tijdgebonden machtigingen goed vanaf je telefoon via baobuddy://-links."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślnie odcinaj agentom dostęp do sekretów i SSH; zatwierdzaj ograniczone czasowo uprawnienia z telefonu przez linki baobuddy://."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha agentes sem acesso a segredos e SSH por padrão; aprove concessões com prazo definido pelo celular por meio de links baobuddy://."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha os agentes sem acesso a segredos e SSH por omissão; aprove concessões com prazo a partir do telemóvel através de ligações baobuddy://."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll agenter borta från hemligheter och SSH som standard; godkänn tidsbegränsade behörigheter från telefonen via baobuddy://-länkar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajanları varsayılan olarak gizli bilgilerden ve SSH'tan uzak tutun; süre sınırlı izinleri baobuddy:// bağlantılarıyla telefonunuzdan onaylayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认禁止代理访问机密和 SSH；通过 baobuddy:// 链接在手机上批准限时授权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設禁止代理程式存取機密和 SSH；透過 baobuddy:// 連結在手機上核准限時授權。"
          }
        }
      }
    },
