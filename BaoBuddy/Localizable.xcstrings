    "%@ (Only %@ confirmed this; no accessor was recorded for this grant.)" : {
      "comment" : "Banner. %1$@ is the remote host's own message; %2$@ is the remote host's name. An accessor is the OpenBao ID of a token.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (أكّد %2$@ ذلك وحده؛ لم يُسجَّل مُعرِّف وصول لهذه المنحة.)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (Nur %2$@ hat dies bestätigt; für diese Freigabe wurde kein Accessor erfasst.)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (Only %2$@ confirmed this; no accessor was recorded for this grant.)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (Solo %2$@ lo ha confirmado; no se registró ningún accessor para esta autorización.)"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (Solo %2$@ lo confirmó; no se registró ningún accessor para esta autorización.)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (Seul %2$@ l’a confirmé ; aucun accessor n’a été enregistré pour cette autorisation.)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (Solo %2$@ lo ha confermato; per questa autorizzazione non è stato registrato alcun accessor.)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@ のみが確認しました。このグラントのアクセサは記録されていません。）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@에서만 확인했으며, 이 접근 권한에 대한 액세서가 기록되지 않았습니다.)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (Alleen %2$@ heeft dit bevestigd; voor deze machtiging is geen accessor vastgelegd.)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (Potwierdził to tylko %2$@; dla tego uprawnienia nie zarejestrowano accessora.)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (Somente %2$@ confirmou isso; nenhum accessor foi registrado para esta concessão.)"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (Apenas %2$@ confirmou isto; não foi registado nenhum accessor para esta concessão.)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (Endast %2$@ bekräftade detta; ingen accessor registrerades för den här behörigheten.)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (Bunu yalnızca %2$@ onayladı; bu izin için accessor kaydedilmedi.)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（仅 %2$@ 确认了此操作；此授权未记录访问器。）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（僅 %2$@ 確認了此操作；此授權未記錄存取器。）"
          }
        }
      }
    },
