        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symulowany serwer w pamięci — nic nie opuszcza tego urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servidor simulado em memória — nada sai deste dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servidor simulado em memória — nada sai deste dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulerad server i minnet — inget lämnar den här enheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bellekte simüle edilen sunucu — bu cihazdan hiçbir şey çıkmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
