    "Private signing keys never leave Apple's Secure Enclave." : {
      "comment" : "Help: security note.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تغادر مفاتيح التوقيع الخاصة Secure Enclave من Apple أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private Signaturschlüssel verlassen nie Apples Secure Enclave."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves de firma privadas nunca salen del Secure Enclave de Apple."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves de firma privadas nunca salen del Secure Enclave de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés de signature privées ne quittent jamais la Secure Enclave d’Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiavi di firma private non lasciano mai il Secure Enclave di Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "秘密署名キーが Apple の Secure Enclave の外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인 서명 키는 Apple Secure Enclave 밖으로 절대 나가지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privé-ondertekeningssleutels verlaten nooit de Secure Enclave van Apple."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prywatne klucze podpisywania nigdy nie opuszczają Secure Enclave firmy Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves privadas de assinatura nunca saem do Secure Enclave da Apple."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves privadas de assinatura nunca saem do Secure Enclave da Apple."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privata signeringsnycklar lämnar aldrig Apples Secure Enclave."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel imzalama anahtarları Apple'ın Secure Enclave'inden asla çıkmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私有签名密钥绝不会离开 Apple Secure Enclave。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私密簽署金鑰絕不會離開 Apple Secure Enclave。"
          }
        }
      }
    },
    "Reachable over HTTPS or your private VPN/LAN. Self-signed and private CA certificates are supported via pinned PEM." : {
      "comment" : "Help: setup step.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن الوصول إليه عبر HTTPS أو شبكة VPN/LAN الخاصة بك. الشهادات الموقَّعة ذاتيًا وشهادات CA الخاصة مدعومة عبر PEM مثبّت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreichbar über HTTPS oder dein privates VPN/LAN. Selbstsignierte Zertifikate und Zertifikate privater CAs werden über ein gepinntes PEM unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesible por HTTPS o tu VPN/LAN privada. Se admiten certificados autofirmados y de CA privada mediante un PEM fijado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesible por HTTPS o tu VPN/LAN privada. Se admiten certificados autofirmados y de CA privada mediante un PEM fijado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessible via HTTPS ou votre VPN/LAN privé. Les certificats autosignés et de CA privée sont pris en charge via un PEM épinglé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raggiungibile tramite HTTPS o la tua VPN/LAN privata. I certificati autofirmati e di CA private sono supportati tramite PEM fissato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS またはプライベート VPN/LAN 経由で接続できること。自己署名証明書やプライベート CA の証明書も、ピン留めした PEM でサポートされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS 또는 사설 VPN/LAN을 통해 접근할 수 있어야 합니다. 자체 서명 인증서 및 사설 CA 인증서는 고정 PEM을 통해 지원됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereikbaar via HTTPS of je privé-VPN/-LAN. Zelfondertekende certificaten en certificaten van een privé-CA worden ondersteund via een vastgepinde PEM."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostępny przez HTTPS lub prywatną sieć VPN/LAN. Certyfikaty z podpisem własnym i z prywatnego CA są obsługiwane dzięki przypiętemu PEM."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acessível via HTTPS ou pela sua VPN/LAN privada. Certificados autoassinados e de CA privada são compatíveis via PEM fixado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acessível por HTTPS ou através da sua VPN/LAN privada. São suportados certificados autoassinados e de CA privada através de PEM fixado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nåbar via HTTPS eller ditt privata VPN/LAN. Självsignerade certifikat och certifikat från privata CA stöds via fäst PEM."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS veya özel VPN/LAN'iniz üzerinden erişilebilir olmalıdır. Kendinden imzalı ve özel CA sertifikaları, sabitlenmiş PEM ile desteklenir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可通过 HTTPS 或你的私有 VPN/局域网访问。支持通过固定的 PEM 使用自签名证书和私有 CA 证书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可透過 HTTPS 或你的私人 VPN/區域網路連線。支援透過固定的 PEM 使用自簽憑證和私人 CA 憑證。"
          }
        }
      }
    },
    "Reachable over TLS, but OpenBao is currently sealed." : {
      "comment" : "Connection test result. Sealed means the OpenBao server is locked and can't serve secrets until an operator unseals it.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
