    "Make sure you are on your private network or VPN before testing." : {
      "comment" : "Setup footer.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكّد من أنك متصل بشبكتك الخاصة أو بشبكة VPN قبل الاختبار."
          }
        },
        "de" : {
          "stringUnit" : {
