    "Includes permissions beyond read-only access. Verify the scope below before authenticating." : {
      "comment" : "Approval sheet warning for an elevated grant.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتضمن صلاحيات تتجاوز القراءة فقط. تحقّق من النطاق أدناه قبل المصادقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält Berechtigungen über reinen Lesezugriff hinaus. Prüfe den Umfang unten, bevor du dich authentifizierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye permisos más allá de solo lectura. Comprueba el alcance a continuación antes de autenticarte."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye permisos más allá de solo lectura. Verifica el alcance a continuación antes de autenticarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclut des droits au-delà de la lecture seule. Vérifiez la portée ci-dessous avant de vous authentifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include permessi che vanno oltre l'accesso in sola lettura. Verifica l'ambito qui sotto prima di autenticarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み取り専用を超える権限が含まれます。認証する前に、以下のスコープを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽기 전용을 넘어서는 권한이 포함되어 있습니다. 인증하기 전에 아래 범위를 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevat rechten die verder gaan dan alleen-lezentoegang. Controleer het bereik hieronder voordat je je authenticeert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obejmuje uprawnienia wykraczające poza dostęp tylko do odczytu. Przed uwierzytelnieniem sprawdź poniższy zakres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclui permissões além do acesso somente leitura. Verifique o escopo abaixo antes de autenticar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclui permissões além do acesso só de leitura. Verifique o âmbito abaixo antes de autenticar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innehåller behörigheter utöver skrivskyddad åtkomst. Kontrollera omfattningen nedan innan du autentiserar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salt okunur erişimin ötesinde yetkiler içerir. Kimlik doğrulamadan önce aşağıdaki kapsamı doğrulayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含超出只读访问的权限。认证前请核对下方的范围。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含超出唯讀存取的權限。認證前請核對下方的範圍。"
          }
        }
      }
    },
    "Invoke dynamic OpenBao secrets engines (AWS STS, Kubernetes, Database, PKI, GitHub) using the grant token." : {
      "comment" : "Server editor footer. Secrets engines are OpenBao components; the names in parentheses are products.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استدعِ محركات أسرار OpenBao الديناميكية (AWS STS وKubernetes وDatabase وPKI وGitHub) باستخدام الرمز المميز للمنحة."
          }
        },
        "de" : {
