    "Import a JSON profile or add your server manually with custom policies. Add an SSH target only if you want remote delivery." : {
      "comment" : "Help: setup step.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استورد ملف تعريف JSON أو أضف خادمك يدويًا مع سياسات مخصصة. أضف هدف SSH فقط إذا كنت تريد التسليم عن بُعد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere ein JSON-Profil oder füge deinen Server manuell mit eigenen Richtlinien hinzu. Füge ein SSH-Ziel nur hinzu, wenn du Remote-Zustellung möchtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa un perfil JSON o añade tu servidor manualmente con políticas personalizadas. Añade un destino SSH solo si quieres entrega remota."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa un perfil JSON o agrega tu servidor manualmente con políticas personalizadas. Agrega un destino SSH solo si quieres entrega remota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez un profil JSON ou ajoutez votre serveur manuellement avec des politiques personnalisées. N’ajoutez une cible SSH que si vous souhaitez la livraison distante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa un profilo JSON o aggiungi il server manualmente con policy personalizzate. Aggiungi una destinazione SSH solo se vuoi la consegna remota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON プロファイルを読み込むか、カスタムポリシー付きでサーバを手動で追加します。SSH ターゲットは、リモート配信を使う場合にのみ追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON 프로파일을 가져오거나 사용자 지정 정책과 함께 서버를 수동으로 추가합니다. SSH 대상은 원격 전달을 사용하려는 경우에만 추가하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importeer een JSON-profiel of voeg je server handmatig toe met aangepaste policy's. Voeg alleen een SSH-doel toe als je externe levering wilt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaimportuj profil JSON lub dodaj serwer ręcznie z własnymi politykami. Cel SSH dodaj tylko wtedy, gdy chcesz zdalnego dostarczania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe um perfil JSON ou adicione seu servidor manualmente com políticas personalizadas. Adicione um destino SSH somente se quiser entrega remota."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe um perfil JSON ou adicione o servidor manualmente com políticas personalizadas. Adicione um destino SSH apenas se pretender entrega remota."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importera en JSON-profil eller lägg till servern manuellt med anpassade policyer. Lägg bara till ett SSH-mål om du vill ha fjärrleverans."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir JSON profilini içe aktarın veya sunucunuzu özel ilkelerle elle ekleyin. SSH hedefini yalnızca uzak teslimat istiyorsanız ekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入 JSON 配置文件，或使用自定义策略手动添加服务器。仅在需要远程下发时添加 SSH 目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匯入 JSON 設定檔，或以自訂政策手動加入伺服器。只有在需要遠端傳送時才加入 SSH 目標。"
          }
        }
      }
    },
    "In BaoBuddy on Mac, open Settings → Share & Export → Pair iPhone (QR Code), or run `bao-buddy export-profile --qr`." : {
      "comment" : "Setup footer. 'Settings → Share & Export → Pair iPhone (QR Code)' names screens in BaoBuddy for Mac, which is in English only. Do not translate the command in backticks.",
