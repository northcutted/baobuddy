        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definisci policy personalizzate come k8s-deploy, terraform-apply o db-write e genera con %@ token di 1 ora sottoposti ad audit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "k8s-deploy、terraform-apply、db-write などのカスタムポリシーを定義し、%@ で監査付きの1時間トークンを発行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "k8s-deploy, terraform-apply, db-write 같은 사용자 지정 정책을 정의하고 %@(으)로 감사되는 1시간 토큰을 발급합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
