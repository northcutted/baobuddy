    "Each policy you add becomes an interactive toggle in the Grants tab and Approval sheet." : {
      "comment" : "Server editor footer. \"Grants\" names the app's tab.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصبح كل سياسة تضيفها مفتاح تبديل تفاعليًا في علامة تبويب المنح وورقة الموافقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede hinzugefügte Richtlinie wird im Tab „Freigaben“ und im Genehmigungsdialog zu einem interaktiven Schalter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada política que añadas se convierte en un interruptor interactivo en la pestaña Autorizaciones y en la hoja de aprobación."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada política que agregues se convierte en un interruptor interactivo en la pestaña Autorizaciones y en la hoja de aprobación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque politique ajoutée devient un bouton interactif dans l’onglet Autorisations et dans la fiche d’approbation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni policy che aggiungi diventa un interruttore nella scheda Autorizzazioni e nel foglio di approvazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加した各ポリシーは、“グラント”タブと承認シートで切り替えスイッチになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가한 각 정책은 접근 권한 탭과 승인 시트에서 토글로 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke policy die je toevoegt, wordt een schakelaar op het tabblad Machtigingen en in het goedkeuringsvenster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda dodana polityka staje się przełącznikiem na karcie Uprawnienia i w arkuszu zatwierdzania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada política adicionada vira uma opção interativa na aba Concessões e na tela de aprovação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada política que adicionar passa a ser um interruptor no separador Concessões e na folha de aprovação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje policy du lägger till blir ett reglage på fliken Behörigheter och i godkännandebladet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklediğiniz her ilke, İzinler sekmesinde ve Onay sayfasında etkileşimli bir açma/kapama düğmesine dönüşür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
