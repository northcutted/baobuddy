    "Direct tokens copy to a 2-minute auto-expiring clipboard." : {
      "comment" : "Help: security note.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُنسخ الرموز المباشرة إلى حافظة تنتهي صلاحيتها تلقائيًا بعد دقيقتين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkt-Tokens werden in eine Zwischenablage kopiert, die nach 2 Minuten automatisch abläuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tokens directos se copian en un portapapeles que caduca automáticamente a los 2 minutos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tokens directos se copian en un portapapeles que vence automáticamente a los 2 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jetons directs sont copiés dans un presse-papiers qui expire automatiquement au bout de 2 minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I token diretti vengono copiati negli appunti con scadenza automatica dopo 2 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダイレクトトークンは、2分で自動的に期限切れになるクリップボードにコピーされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 토큰은 2분 후 자동으로 만료되는 클립보드에 복사됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Directe tokens worden gekopieerd naar een klembord dat na 2 minuten automatisch verloopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokeny bezpośrednie są kopiowane do schowka, który wygasa automatycznie po 2 minutach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens diretos são copiados para uma área de transferência que expira automaticamente em 2 minutos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os tokens diretos são copiados para uma área de transferência que expira automaticamente ao fim de 2 minutos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkta token kopieras till ett urklipp som rensas automatiskt efter 2 minuter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğrudan token'lar, 2 dakika sonra kendiliğinden silinen panoya kopyalanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接令牌会拷贝到 2 分钟后自动过期的剪贴板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
