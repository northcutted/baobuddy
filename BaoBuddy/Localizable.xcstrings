    "Minted with the grant and delivered to %@. They end when the grant is revoked or expires." : {
      "comment" : "Footer about credential extensions. %@ is the remote host's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُصدر مع المنحة وتُسلَّم إلى %@. تنتهي عند إبطال المنحة أو انتهاء صلاحيتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Freigabe ausgestellt und an %@ zugestellt. Sie enden, wenn die Freigabe widerrufen wird oder abläuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emitidas con la autorización y entregadas a %@. Finalizan cuando la autorización se revoca o caduca."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emitidas con la autorización y entregadas a %@. Finalizan cuando la autorización se revoca o vence."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Émis avec l’autorisation et livrés à %@. Ils prennent fin lorsque l’autorisation est révoquée ou expire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generate con l'autorizzazione e consegnate a %@. Terminano quando l'autorizzazione viene revocata o scade."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グラントとともに発行され、%@ に配信されます。グラントが取り消されるか期限切れになると無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "접근 권한과 함께 발급되어 %@에 전달됩니다. 접근 권한이 철회되거나 만료되면 종료됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aangemaakt met de machtiging en geleverd aan %@. Ze vervallen wanneer de machtiging wordt ingetrokken of verloopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tworzone wraz z uprawnieniem i dostarczane do %@. Wygasają, gdy uprawnienie zostanie odwołane lub wygaśnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emitidas com a concessão e entregues a %@. Elas terminam quando a concessão é revogada ou expira."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emitidas com a concessão e entregues a %@. Terminam quando a concessão é revogada ou expira."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapas med behörigheten och levereras till %@. De upphör när behörigheten återkallas eller löper ut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzinle birlikte oluşturulur ve %@ ana bilgisayarına teslim edilir. İzin iptal edildiğinde veya süresi dolduğunda sona ererler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随授权签发并下发到 %@。授权被撤销或过期时即失效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隨授權簽發並傳送至 %@。授權遭撤銷或過期時即失效。"
          }
        }
      }
    },
    "Minted with the grant and shown here. They end when the grant is revoked or expires." : {
      "comment" : "Footer about credential extensions.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُصدر مع المنحة وتظهر هنا. تنتهي عند إبطال المنحة أو انتهاء صلاحيتها."
