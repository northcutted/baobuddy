        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define políticas personalizadas como k8s-deploy, terraform-apply o db-write y emite con %@ tokens auditados de 1 hora."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define políticas personalizadas como k8s-deploy, terraform-apply o db-write y emite con %@ tokens auditados de 1 hora."
          }
        },
