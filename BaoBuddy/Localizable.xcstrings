    "Revoked the grant through OpenBao, but %@ didn't confirm deleting its copies." : {
      "comment" : "Banner. %@ is the remote host's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إبطال المنحة عبر OpenBao، لكن %@ لم يؤكد حذف نسخه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freigabe über OpenBao widerrufen, aber %@ hat das Löschen seiner Kopien nicht bestätigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorización revocada mediante OpenBao, pero %@ no ha confirmado la eliminación de sus copias."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorización revocada mediante OpenBao, pero %@ no confirmó la eliminación de sus copias."
          }
        },
        "fr" : {
