    "Standard read/write mode preserves any restricted keys and SSH hosts from imported profiles." : {
      "comment" : "Server editor footer.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ وضع القراءة/الكتابة القياسي بأي مفاتيح مقيّدة ومضيفي SSH من ملفات التعريف المستوردة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standardmodus „Lesen / Schreiben“ behält eingeschränkte Schlüssel und SSH-Hosts aus importierten Profilen bei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo estándar Lectura / Escritura conserva las claves restringidas y los hosts SSH de los perfiles importados."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo estándar Lectura / Escritura conserva las claves restringidas y los hosts SSH de los perfiles importados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode standard Lecture / Écriture conserve les clés restreintes et les hôtes SSH des profils importés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità lettura/scrittura standard mantiene le chiavi riservate e gli host SSH dei profili importati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標準の読み取り/書き込みモードでは、読み込んだプロファイルの制限付きキーと SSH ホストが保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표준 읽기/쓰기 모드에서는 가져온 프로파일의 제한된 키와 SSH 호스트가 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De standaardmodus lezen/schrijven behoudt beperkte sleutels en SSH-hosts uit geïmporteerde profielen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardowy tryb odczytu/zapisu zachowuje klucze z ograniczeniami i hosty SSH z zaimportowanych profili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo padrão de leitura/gravação preserva as chaves restritas e os hosts SSH dos perfis importados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
