    "Couldn't check running tasks; this grant will reach any workloads active on %@." : {
      "comment" : "Approval sheet warning. %@ is the remote host's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر التحقق من المهام قيد التشغيل؛ ستصل هذه المنحة إلى أي أحمال عمل نشطة على %@."
          }
        },
        "de" : {
          "stringUnit" : {
