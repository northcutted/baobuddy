    "Swipe left on a server to remove it, or tap info to edit its policies and target." : {
      "comment" : "Settings footer. \"info\" refers to the ⓘ button.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لليمين على خادم لإزالته، أو اضغط على زر المعلومات لتعديل سياساته وهدفه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streiche auf einem Server nach links, um ihn zu entfernen, oder tippe auf ⓘ, um seine Richtlinien und sein Ziel zu bearbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza un servidor a la izquierda para eliminarlo o toca ⓘ para editar sus políticas y su destino."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza un servidor a la izquierda para eliminarlo o toca ⓘ para editar sus políticas y su destino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez un serveur vers la gauche pour le supprimer, ou touchez ⓘ pour modifier ses politiques et sa cible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri a sinistra su un server per rimuoverlo oppure tocca info per modificarne le policy e la destinazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバを削除するには左にスワイプします。ポリシーとターゲットを編集するには情報ボタンをタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버를 제거하려면 왼쪽으로 쓸어넘기고, 정책과 대상을 편집하려면 정보 버튼을 탭하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
