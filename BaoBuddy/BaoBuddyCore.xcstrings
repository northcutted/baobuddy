    "Remote grant accessor state at %@ is unreadable or corrupt; refusing to overwrite or ignore recorded grants." : {
      "comment" : "Error. %@ is a file path. An accessor is the OpenBao/Vault ID of a token.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حالة مُعرِّفات الوصول للمنح البعيدة في %@ غير قابلة للقراءة أو تالفة؛ تم رفض الكتابة فوقها أو تجاهل المنح المسجلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Accessor-Status der Remote-Freigaben unter %@ ist unlesbar oder beschädigt; erfasste Freigaben werden weder überschrieben noch ignoriert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El estado de accessors de autorizaciones remotas en %@ no se puede leer o está dañado; no se sobrescribirán ni ignorarán las autorizaciones registradas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El estado de accessors de autorizaciones remotas en %@ no se puede leer o está dañado; no se sobrescribirán ni ignorarán las autorizaciones registradas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’état des accessors des autorisations distantes dans %@ est illisible ou corrompu ; les autorisations enregistrées ne seront ni écrasées ni ignorées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo stato degli accessor delle autorizzazioni remote in %@ è illeggibile o danneggiato; le autorizzazioni registrate non verranno sovrascritte né ignorate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のリモートグラントのアクセサ状態が読み取れないか破損しています。記録済みのグラントの上書きや無視は行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 원격 접근 권한 액세서 상태를 읽을 수 없거나 손상되었습니다. 기록된 접근 권한을 덮어쓰거나 무시하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status van externe machtigingsaccessors op %@ is onleesbaar of beschadigd; vastgelegde machtigingen worden niet overschreven of genegeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stan accessorów zdalnych uprawnień w %@ jest nieczytelny lub uszkodzony; zapisane uprawnienia nie zostaną nadpisane ani pominięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O estado dos accessors de concessões remotas em %@ está ilegível ou corrompido; as concessões registradas não serão sobrescritas nem ignoradas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O estado dos accessors de concessões remotas em %@ está ilegível ou danificado; as concessões registadas não serão substituídas nem ignoradas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillståndet för fjärrbehörigheternas accessorer på %@ är oläsligt eller skadat; registrerade behörigheter skrivs inte över och ignoreras inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konumundaki uzak izin accessor durumu okunamıyor veya bozuk; kayıtlı izinlerin üzerine yazma veya yok sayma reddediliyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 处的远程授权访问器状态不可读或已损坏；拒绝覆盖或忽略已记录的授权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的遠端授權存取器狀態無法讀取或已損毀；拒絕覆寫或忽略已記錄的授權。"
          }
        }
      }
    },
