    "%lld Keychain certificates match '%@'; set mtls_client_identity to the certificate's sha256: fingerprint" : {
      "comment" : "Error. %1$lld is a number of certificates; %2$@ is the name searched for. Do not translate mtls_client_identity or sha256: (they are literal setting names).",
